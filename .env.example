# App
NODE_ENV=development
PORT=3001
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://peja:peja@localhost:5432/peja

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional — leave empty to disable feature
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
SENTRY_ENV=development

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_ESSENTIALS=price_...
STRIPE_PRICE_ID_PREMIUM=price_...
STRIPE_PRICE_ID_BUNDLE=price_...

# Object Storage (S3-compatible — matches docker-compose MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=peja-uploads
OBJECT_STORAGE_PUBLIC_DOMAIN=http://localhost:9000/peja-uploads

# Transcription (OpenAI Whisper)
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=Peja <hello@peja.app>

# Anti-spam — rate limits on public guest endpoints
RATE_LIMIT_MESSAGES_PER_IP=5
RATE_LIMIT_UPLOAD_URL_PER_IP=20
RATE_LIMIT_INVITATIONS_PER_IP=60
RATE_LIMIT_MESSAGES_PER_SLUG=100
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_PER_SLUG_WINDOW_MS=3600000

# Anti-spam — dwell time bounds for guest submission form (ms)
DWELL_TIME_MIN_MS=3000
DWELL_TIME_MAX_MS=86400000
