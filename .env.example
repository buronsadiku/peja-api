# App
NODE_ENV=development
PORT=3001
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://peja:peja@localhost:5432/peja

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional — leave empty to disable feature
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
SENTRY_ENV=development

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_ESSENTIALS=price_...
STRIPE_PRICE_ID_PREMIUM=price_...
STRIPE_PRICE_ID_BUNDLE=price_...

# Object Storage (Cloudinary)
# Easiest: paste the single CLOUDINARY_URL from Cloudinary dashboard
# (format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=
# Or use the three split vars instead (leave CLOUDINARY_URL empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=peja

# Transcription (OpenAI Whisper)
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=Peja <hello@peja.app>


