{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "common/i18n/translations/**/*.json",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "database/migrations/**/*",
        "outDir": "dist/src",
        "watchAssets": false
      }
    ],
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": false,
          "introspectComments": true
        }
      }
    ]
  }
}
